{
  "threshold": 0,
  "reporters": ["console", "json"],
  "output": ".jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/_site/**",
    "**/.build/**",
    "**/chobble-template/**",
    "**/wp-content/**",
    "**/wp-includes/**",
    "**/_includes/head.html",
    "**/_includes/site-header.html",
    "**/_layouts/**",
    "**/locations/**",
    "**/scripts/migrate-*.js",
    "**/scripts/clean-descriptions.js",
    "**/scripts/fetch-*.js"
  ],
  "format": ["javascript", "markup", "css"],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "minLines": 3,
  "minTokens": 39,
  "path": [
    "scripts",
    "_includes",
    "_layouts",
    "_data",
    "css",
    "locations",
    "service-pages",
    "pages",
    "reviews"
  ]
}
